// Waybar configuration
//
// For display of symbols font ttf-nerd-fonts-symbols is required
//
// =============================================================================

{
  "layer": "top",
  "height": 30,
  "position": "bottom",
  "modules-left": [
    "sway/workspaces",
    "sway/window"
  ],
  "modules-center": [
    "custom/wf-recorder",
    "sway/mode"
  ],
  "modules-right": [
    "tray",
    "pulseaudio",
    "bluetooth",
    "network",
    "idle_inhibitor",
    "battery",
    "clock"
  ],
  "backlight": {
    "format": "{icon} {percent}%",
    "format-icons": [
      "󱓤",
      "󰖙"
    ],
    "on-scroll-down": "swaymsg exec '$brightness_down'",
    "on-scroll-up": "swaymsg exec '$brightness_up'"
    },
  "battery": {
    "format": "{icon}",
    "format-icons": [
      "󰁺",
      "󰁻",
      "󰁼",
      "󰁽",
      "󰁾",
      "󰁿",
      "󰂀",
      "󰂁",
      "󰂂",
      "󰁹"
    ],
    "format-charging": "{capacity}% 󰂄",
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 10
    },
    "tooltip-format": "{capacity}%"
  },
  "bluetooth": {
    "format": "󰂯",
    "format-connected": "󰂱",
    "format-disabled": "󰂲",
    "on-click": "swaymsg exec '$bluetooth_manager'",
    "tooltip-format": "{controller_alias}\t{controller_address}\n\n{num_connections} connected",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{num_connections} connected\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "tooltip-format-enumerate-connected-battery": "{device_alias}\t{device_address}\t{device_battery_percentage}%"
  },
  "clock": {
    "interval": 60,
    "format": "{:%H:%M}",
    "tooltip-format": "{:%a %d %b}",
    "on-click": "swaymsg exec '$calendar'"
  },
  "cpu": {
    "interval": 5,
    "format": "{usage}% {icon}",
    "format-icons": [
      ""
    ],
    "states": {
      "warning": 80,
      "critical": 90
    },
    "on-click": "swaymsg exec '$resource_monitor'",
    "tooltip": true
  },
  "disk": {
    "interval": 30,
    "format": "{free} ",
    "path": "/home",
    "on-click": "swaymsg exec '$file_manager'"
  },
  "idle_inhibitor": {
    "format": "{icon}",
    "format-icons": {
      "activated": "󰈈",
      "deactivated": "󰈉"
    },
    "tooltip": true
  },
  "memory": {
    "interval": 10,
    "format": "{}% ",
    "states": {
      "warning": 70,
      "critical": 90
    },
    "on-click": "swaymsg exec '$resource_monitor'",
    "tooltip": true
  },
  "network": {
    "format": "{icon}",
    "interval": 15,
    "on-click": "swaymsg exec '$network_manager'",
    "format-icons": {
      "ethernet": "󰈀",
      "wifi": "󰖩",
      "disconnected": ""
    },
    "tooltip-format-wifi": "{ipaddr}/{cidr}",
    "tooltip-format-ethernet": "{ipaddr}/{cidr}",
    "tooltip-format-disconnected": "Disconnected",
    "max-length": 50
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-muted": "󰖁 {format_source}",
    "format-source": "󰍬",
    "format-source-muted": "󰍭",
    "format-icons": {
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ]
    },
    "scroll-step": 5,
    "on-click": "swaymsg exec '$audio_control'",
    "on-click-right": "swaymsg exec '$source_mute'",
    "on-scroll-down": "swaymsg exec '$volume_down'",
    "on-scroll-up": "swaymsg exec '$volume_up'"

  },
  "sway/mode": {
    "format": "󰄾 {}",
    "tooltip": false
  },
  "sway/window": {
    "max-length": 50
  },
  "sway/workspaces": {
    "format": "{name}",
    "disable-scroll": true
  },
  "tray": {
    "icon-size": 18,
    "spacing": 3
  },
  "custom/wf-recorder": {
        "interval": "once",
        "return-type": "json",
        "format": "{}",
        "tooltip-format": "{tooltip}",
        "exec": "echo '{\"class\": \"recording\",\"text\":\"󰑊\",\"tooltip\":\"press $mod+Esc to stop recording\"}'",
        "exec-if": "pgrep wf-recorder",
        "on-click": "killall -s SIGINT wf-recorder",
        "signal": 8
  }
}
