# --------------------
# Output configuration
# --------------------
# You can get the names of your outputs by running: swaymsg -t get_outputs

# Set wallpaper
output * bg $wallpaper_background fill

# Set outputs
output DP-1 {
    #mode 1920x1080@120.000Hz pos 0,0
    #mode 2560x1440@59.951Hz pos 0,0
    #mode 2560x1440@164.958Hz pos 0,0
    mode 2560x1440@179.960Hz pos 0,0
    adaptive_sync on
}
output HDMI-A-1 {
    mode 1920x1080@60.000Hz pos 0,0
}
