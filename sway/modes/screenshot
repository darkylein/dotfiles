# --------------------
# Taking screenshot
# --------------------

set $mode_screenshot Screenshot: (o) screen, (O) screen to file, (p) selection, (P) selection to file
mode "$mode_screenshot" {
    # output = currently active output
    # capture screen and save to clipboard
    bindsym o mode "default", exec $screenshot_screen
    # capture screen and save to file
    bindsym Shift+o mode "default", exec $screenshot_screen_to_file
    # pick the region to screenshot and save to clipboard
    bindsym p mode "default", exec $screenshot_selection
    # pick the region to screenshot and save to file
    bindsym Shift+p mode "default", exec $screenshot_selection_to_file
    
    # Return to default mode
    bindsym Return mode "default"
    bindsym Escape mode "default"
}

bindsym Print mode  "$mode_screenshot"
